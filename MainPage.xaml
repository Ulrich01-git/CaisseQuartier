<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CaisseQuartier.Controls"
             x:Class="CaisseQuartier.MainPage"
             Style="{StaticResource CqPage}">
    <ScrollView>
        <Grid Padding="24,32"
              HorizontalOptions="Center"
              WidthRequest="1000">
            <Border WidthRequest="560"
                    MaximumWidthRequest="560"
                    HorizontalOptions="Center"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="30"
                    Shadow="{StaticResource CqShadow}">
                <VerticalStackLayout Spacing="18">
                    <Border WidthRequest="88"
                            HeightRequest="88"
                            BackgroundColor="#E8F5EE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            HorizontalOptions="Center">
                        <Label Text="CQ"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#0D8B5D"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Connexion"
                               Style="{StaticResource PageTitle}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Accédez à votre caisse et suivez les cotisations en temps réel."
                               FontSize="14"
                               TextColor="#475569"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <controls:FormField x:Name="IdentifierField"
                                       Title="Identifiant"
                                       Placeholder="Numéro de téléphone ou email" />

                    <controls:FormField x:Name="PasswordField"
                                       Title="Mot de passe"
                                       Placeholder="Votre mot de passe"
                                       IsPassword="True" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mot de passe oublié ?"
                               FontSize="12"
                               TextColor="#2563EB"
                               Margin="4,0,0,0" />
                        <Label Grid.Column="1"
                               Text="Aide"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#64748B">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Button x:Name="LoginButton"
                            Text="Se connecter"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnLoginClicked" />

                    <Label Text="Vous n'avez pas de compte ?"
                           FontSize="13"
                           TextColor="#475569"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Créer un compte"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnCreateAccountClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
