<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="CaisseQuartier.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CaisseQuartier.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.BackgroundColor="#F7F7F7"
       Title="CaisseQuartier">

    <ShellContent Title="Bienvenue" Route="WelcomePage"
                  ContentTemplate="{DataTemplate views:WelcomePage}" />

    <ShellContent Title="Connexion" Route="ConnexionPage"
                  ContentTemplate="{DataTemplate views:ConnexionPage}" />

    <ShellContent Title="Inscription" Route="InscriptionPage"
                  ContentTemplate="{DataTemplate views:InscriptionPage}" />

    <ShellContent Title="Accueil" Route="AccueilPage"
                  ContentTemplate="{DataTemplate views:AccueilPage}" />
</Shell>
