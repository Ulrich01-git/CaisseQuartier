<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.DashboardPage"
             Style="{StaticResource CqPage}">
    <ScrollView>
        <VerticalStackLayout Padding="24,26" Spacing="18" HorizontalOptions="Center" WidthRequest="1200">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" VerticalOptions="Center">
                <VerticalStackLayout>
                    <Label Text="Bonjour, Assane"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label Text="Caisse: Groupe AIC"
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="+ Nouveau"
                        Style="{StaticResource ActionButton}"
                        Clicked="OnCreateContributionClicked" />
            </Grid>

            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="16">
                <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Total cotisations" FontSize="12" TextColor="#64748B" />
                        <Label Text="1 250 000 FCFA" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="+12.5% ce mois" FontSize="12" TextColor="#15803D" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Dépenses" FontSize="12" TextColor="#64748B" />
                        <Label Text="480 000 FCFA" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="-3.2% ce mois" FontSize="12" TextColor="#B91C1C" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Solde" FontSize="12" TextColor="#64748B" />
                        <Label Text="770 000 FCFA" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Disponible" FontSize="12" TextColor="#0D8B5D" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Raccourcis" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="1*,1*,1*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Button Grid.Column="0" Text="Membres" Clicked="OnMembersClicked" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" Text="Cotisations" Clicked="OnContributionsClicked" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="2" Text="Dépenses" Clicked="OnExpensesClicked" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="0" Grid.Row="1" Text="Rapports" Clicked="OnReportsClicked" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="1" Grid.Row="1" Text="Relances" Clicked="OnRemindersClicked" Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="2" Grid.Row="1" Text="Paramètres" Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Dernières cotisations" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="Voir tout" TextColor="#2563EB" FontAttributes="Bold" />
                    </Grid>
                    <VerticalStackLayout Spacing="10">
                        <Border Padding="12,10" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="Moussa Diop" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Cotisation mensuelle" FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="50 000 FCFA" FontAttributes="Bold" TextColor="#0F172A" />
                            </Grid>
                        </Border>
                        <Border Padding="12,10" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="Awa Sarr" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="Cotisation mensuelle" FontSize="12" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="50 000 FCFA" FontAttributes="Bold" TextColor="#0F172A" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
