<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.ReportsPage"
             Style="{StaticResource CqPage}">
    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="18" HorizontalOptions="Center" WidthRequest="1200">
            <Label Text="Rapports"
                   Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Période" FontAttributes="Bold" TextColor="#0F172A" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <DatePicker x:Name="StartDate" Date="2026-06-01" />
                        <DatePicker x:Name="EndDate" Date="2026-06-30" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="1*,1*,1*" ColumnSpacing="16">
                <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Cotisations" FontSize="12" TextColor="#64748B" />
                        <Label Text="1 250 000 FCFA" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Dépenses" FontSize="12" TextColor="#64748B" />
                        <Label Text="480 000 FCFA" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Solde" FontSize="12" TextColor="#64748B" />
                        <Label Text="770 000 FCFA" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardContainer}" Shadow="{StaticResource CqShadow}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Synthèse" Style="{StaticResource SectionTitle}" />
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Membres à jour" TextColor="#475569" />
                            <Label Grid.Column="1" Text="11/12" FontAttributes="Bold" TextColor="#0F172A" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Relances envoyées" TextColor="#475569" />
                            <Label Grid.Column="1" Text="03" FontAttributes="Bold" TextColor="#0F172A" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Taux de collecte" TextColor="#475569" />
                            <Label Grid.Column="1" Text="89%" FontAttributes="Bold" TextColor="#0F172A" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
