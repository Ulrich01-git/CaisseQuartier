<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CaisseQuartier.Controls"
             x:Class="CaisseQuartier.RemindersPage"
             Style="{StaticResource CqPage}">
    <Grid RowDefinitions="Auto,*" Padding="24,24" RowSpacing="16" HorizontalOptions="Center" WidthRequest="1200">
        <Label Text="Relances"
               Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="18"
                Shadow="{StaticResource CqShadow}">
            <VerticalStackLayout Spacing="12">
                <CollectionView x:Name="RemindersList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12"
                                    Margin="0,0,0,8"
                                    BackgroundColor="#F8FAFC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="#64748B" />
                                        <Label Text="{Binding Date}" FontSize="11" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout HorizontalOptions="End" Spacing="8">
                                        <controls:StatusBadge IsLate="{Binding IsLate}" />
                                        <Button Text="Relancer"
                                                FontSize="12"
                                                Padding="10,6"
                                                HeightRequest="36"
                                                BackgroundColor="#DBEAFE"
                                                TextColor="#1E40AF"
                                                Clicked="OnReminderClicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
