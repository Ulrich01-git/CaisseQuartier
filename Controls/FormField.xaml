<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.FormField"
             x:Name="Root">
    <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource FieldLabel}" />

        <Border x:Name="InputBorder" Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="Input"
                       Style="{StaticResource BareEntry}"
                       Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                       Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                       IsPassword="{Binding IsPassword, Source={x:Reference Root}}"
                       Focused="OnInputFocused"
                       Unfocused="OnInputUnfocused"
                       TextChanged="OnInputTextChanged" />
                <Label x:Name="SuffixLabel" Grid.Column="1"
                       Style="{StaticResource SubtitleText}"
                       VerticalOptions="Center" IsVisible="False" />
            </Grid>
        </Border>

        <Grid x:Name="ErrorRow" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="False">
            <Image Source="icon_alert_red.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Start" Margin="0,1,0,0" />
            <Label Grid.Column="1" Text="{Binding ErrorText, Source={x:Reference Root}}"
                   Style="{StaticResource ErrorText}" VerticalOptions="Center" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
