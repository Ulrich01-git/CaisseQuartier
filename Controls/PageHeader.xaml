<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.PageHeader"
             x:Name="Root">
    <VerticalStackLayout Spacing="2">
        <Label Text="CaisseQuartier" Style="{StaticResource PageKicker}" />
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource PageTitle}" />
    </VerticalStackLayout>
</ContentView>
