<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.ActionButton">
    <Border x:Name="Surface" HeightRequest="48" StrokeThickness="1"
            StrokeShape="RoundRectangle 8" Padding="12,0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Image x:Name="IconView" WidthRequest="20" HeightRequest="20"
                   VerticalOptions="Center" IsVisible="False" />
            <Label x:Name="Caption" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
