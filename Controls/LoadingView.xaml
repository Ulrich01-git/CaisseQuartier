<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.LoadingView"
             x:Name="Root">
    <VerticalStackLayout Spacing="12" Padding="0,24">
        <ActivityIndicator IsRunning="True" Color="{StaticResource CqNavy}"
                           WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
        <Label Text="{Binding Message, Source={x:Reference Root}}"
               Style="{StaticResource SubtitleText}"
               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
