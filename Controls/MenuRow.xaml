<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.MenuRow"
             x:Name="Root">
    <Border Style="{StaticResource CardBorder}" Padding="16,14">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Image Source="{Binding IconSource, Source={x:Reference Root}}"
                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding Title, Source={x:Reference Root}}"
                   Style="{StaticResource ValueLabel}" VerticalOptions="Center" />
            <Image Grid.Column="2" Source="icon_chevron_right.png"
                   WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
