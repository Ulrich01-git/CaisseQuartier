<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.StatusBadge">
    <Border x:Name="Pill" StrokeThickness="0" Padding="10,4"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="End" VerticalOptions="Center">
        <HorizontalStackLayout Spacing="6">
            <Ellipse x:Name="Dot" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
            <Label x:Name="Caption" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
