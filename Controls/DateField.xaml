<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.DateField">
    <Grid HeightRequest="48" IsClippedToBounds="True">
        <Border Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="DateLabel" FontSize="15" TextColor="{StaticResource CqText}"
                       VerticalOptions="Center" />
                <Image Grid.Column="1" Source="icon_calendar.png"
                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
            </Grid>
        </Border>
        <!-- Sélecteur natif quasi transparent, posé par-dessus le champ stylé -->
        <DatePicker x:Name="Picker" Opacity="0.011" DateSelected="OnDateSelected" />
    </Grid>
</ContentView>
