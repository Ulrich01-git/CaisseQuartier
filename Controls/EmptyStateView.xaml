<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.Controls.EmptyStateView"
             x:Name="Root">
    <Border Style="{StaticResource CardBorder}" Padding="24,28">
        <VerticalStackLayout Spacing="10">
            <Border x:Name="IconBox" WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                    StrokeShape="RoundRectangle 10" HorizontalOptions="Center"
                    BackgroundColor="{StaticResource CqInfoSoft}">
                <Image x:Name="IconImage" WidthRequest="22" HeightRequest="22"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label x:Name="TitleLabel"
                   Text="{Binding Title, Source={x:Reference Root}}"
                   FontAttributes="Bold" FontSize="15"
                   TextColor="{StaticResource CqNavy}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding Message, Source={x:Reference Root}}"
                   Style="{StaticResource CaptionText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Border>
</ContentView>
