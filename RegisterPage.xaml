<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CaisseQuartier.Controls"
             x:Class="CaisseQuartier.RegisterPage"
             Style="{StaticResource CqPage}">
    <ScrollView>
        <Grid Padding="20,32">
            <Border WidthRequest="440"
                    HorizontalOptions="Center"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    Padding="28">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Créer un compte"
                           Style="{StaticResource PageTitle}"
                           HorizontalTextAlignment="Center" />

                    <controls:FormField Title="Nom complet"
                                       Placeholder="Votre nom complet" />
                    <controls:FormField Title="Téléphone"
                                       Placeholder="Ex: 777 123 456" />
                    <controls:FormField Title="Email"
                                       Placeholder="nom@example.com" />
                    <controls:FormField Title="Mot de passe"
                                       Placeholder="Choisissez un mot de passe"
                                       IsPassword="True" />
                    <controls:FormField Title="Confirmer le mot de passe"
                                       Placeholder="Confirmez votre mot de passe"
                                       IsPassword="True" />

                    <Button Text="Créer mon compte"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnCreateAccountClicked" />

                    <Button Text="Retour à la connexion"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnBackToLoginClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
