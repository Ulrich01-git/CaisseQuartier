<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaisseQuartier.ExpensesPage"
             Style="{StaticResource CqPage}">
    <Grid RowDefinitions="Auto,*" Padding="24,24" RowSpacing="16" HorizontalOptions="Center" WidthRequest="1200">
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
            <Label Text="Dépenses"
                   Style="{StaticResource PageTitle}" />
            <Button Grid.Column="1"
                    Text="Ajouter"
                    Style="{StaticResource ActionButton}"
                    Clicked="OnAddExpenseClicked" />
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="18"
                Shadow="{StaticResource CqShadow}">
            <VerticalStackLayout Spacing="16">
                <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Total dépenses" FontSize="12" TextColor="#475569" />
                            <Label Text="480 000 FCFA" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Exporter"
                                Style="{StaticResource SecondaryButton}"
                                WidthRequest="120" />
                    </Grid>
                </Border>

                <CollectionView x:Name="ExpensesList" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10"
                                    Margin="0,0,0,8"
                                    BackgroundColor="#F8FAFC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Category}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding Amount, StringFormat='{0} FCFA'}" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Date}" FontSize="11" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
